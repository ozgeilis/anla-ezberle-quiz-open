{
  "cli": {
    "version": ">=25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "prototype"
      }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "production"
      },
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "developmentClient": false,
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "production"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "prototype"
      },
      "ios": {
        "simulator": true
      }
    },
    "ads-preview": {
      "extends": "preview",
      "env": {
        "ADS_MODE": "test",
        "ADS_TEST_BUILD": "1",
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-9642662711398587~8836643534"
      }
    },
    "ads-development": {
      "extends": "development",
      "env": {
        "ADS_MODE": "test",
        "ADS_TEST_BUILD": "1",
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-9642662711398587~8836643534"
      }
    },
    "ads-closed-test": {
      "extends": "production",
      "environment": "preview",
      "env": {
        "ADS_MODE": "test",
        "ADS_TEST_BUILD": "1",
        "ADMOB_ANDROID_APP_ID": "ca-app-pub-9642662711398587~8836643534"
      }
    },
    "ios-simulator-acceptance": {
      "distribution": "internal",
      "environment": "preview",
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "production",
        "ADS_MODE": "off",
        "IOS_APPLE_AUTH": "1",
        "IOS_ADS_MODE": "test"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release"
      }
    },
    "ios-development": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "production",
        "ADS_MODE": "off",
        "IOS_APPLE_AUTH": "1",
        "IOS_BUILD_TARGET": "device",
        "IOS_REGISTERED_BUNDLE_ID": "com.kovynelstudio.anlaezberle",
        "IOS_ADS_MODE": "test"
      },
      "environment": "preview"
    },
    "ios-testflight": {
      "distribution": "store",
      "environment": "preview",
      "developmentClient": false,
      "env": {
        "EXPO_PUBLIC_CONTENT_CHANNEL": "production",
        "ADS_MODE": "off",
        "IOS_APPLE_AUTH": "1",
        "IOS_BUILD_TARGET": "store",
        "IOS_REGISTERED_BUNDLE_ID": "com.kovynelstudio.anlaezberle",
        "IOS_ADS_MODE": "test"
      },
      "ios": {
        "autoIncrement": "buildNumber",
        "buildConfiguration": "Release"
      }
    }
  }
}
