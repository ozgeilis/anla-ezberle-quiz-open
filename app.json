{
  "expo": {
    "name": "Anla & Ezberle",
    "slug": "anla-ezberle-quiz",
    "scheme": "anla-ezberle-quiz",
    "version": "0.1.0",
    "icon": "./assets/images/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anlaezberle.quiz.prototype"
    },
    "android": {
      "package": "com.anlaezberle.quiz.prototype",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-foreground.png",
        "backgroundColor": "#005F65"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Anla & Ezberle",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-mark.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#FFFAF1",
          "dark": {
            "image": "./assets/images/splash-mark.png",
            "backgroundColor": "#00484E"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "game-updates",
          "color": "#005F65",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-asset",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5106d534-5a91-4d21-8e65-5f7db23f4dee"
      }
    }
  }
}
